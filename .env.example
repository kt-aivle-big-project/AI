OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=laro-g2p-agent-v13-19
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# Code-first mission input and one-time Rule / Agent routing
# ---------------------------------------------------------------------------
# Executable work must use canonical IDs: ORD-###, IN-###, R###, K#/R#/H#/O_#/I_#.
# Item names and ITEM_* codes do not identify an outbound order or inbound receipt.
# Invalid/missing codes terminate as input_rejected; they do not open HITL.
# llm_router: one tool-free LLM call normalizes the request and recommends Rule/Agent.
# force_agent: structured events are normalized deterministically and Agent is locked.
# Set FORCE_AGENT_STRUCTURED_INPUT_ROUTER_LLM=true only when explicitly measuring the router LLM.
# force_rule: deterministic Rule baseline; natural language still needs normalization.
DEFAULT_PLANNING_MODE=llm_router
# true is useful for A/B scripts; production front ends should normally use false.
ALLOW_REQUEST_PLANNING_MODE_OVERRIDE=false
AGENT_RETRIEVAL_MODE=parallel_plan
# auto: skip the optional retrieval-planning LLM when the canonical DAG is enough.
# always: always call it. off: deterministic canonical reads only.
AGENT_OPTIONAL_RETRIEVAL_PLANNER=auto
PARALLEL_RETRIEVAL_MAX_WORKERS=4
FORCE_AGENT_STRUCTURED_INPUT_ROUTER_LLM=false

# ---------------------------------------------------------------------------
# Human-in-the-loop checkpoints
# ---------------------------------------------------------------------------
# terminal: return awaiting_human_approval and resume by API.
# HITL is exception-only: safety/authorization, loaded-robot recovery, committed-work
# cancellation, task deferral/SLA conflict, destination override, or authoritative-data conflict.
# Missing IDs, bad aliases, no stock, no robot, and solver infeasibility are not HITL.
HITL_EXECUTION_MODE=terminal
# Empty means OUTPUT_DIR/hitl.
HITL_STORE_DIR=

DATA_DIR=data
OUTPUT_DIR=runtime_outputs

# ---------------------------------------------------------------------------
# Multi-warehouse scope and physical map timing (v13.19)
# ---------------------------------------------------------------------------
# Front-end callers send warehouse_id; the server never accepts DB URIs from clients.
DEFAULT_WAREHOUSE_ID=WH-001
# Non-default JSON warehouses live under data/warehouses/<warehouse_id>.
WAREHOUSE_DATA_ROOT=data/warehouses
# Physical travel uses edge.distance_m / edge.speed_limit_mps. These are fallback values
# only for legacy map edges that do not yet have explicit physical metrics.
MAP_METERS_PER_COORDINATE_UNIT=2.5
ROBOT_NOMINAL_SPEED_MPS=1.0
MINIMUM_EDGE_TRAVEL_TIME_MS=500
# Allow a public planning request to carry a one-shot simulator runtime snapshot.
# Production deployments normally use the warehouse-scoped telemetry API instead.
ALLOW_API_RUNTIME_SNAPSHOT=true

# ---------------------------------------------------------------------------
# NVIDIA Build/API Catalog cuOpt (key from build.nvidia.com/nvidia/nvidia-cuopt)
# ---------------------------------------------------------------------------
OPTIMIZATION_BACKEND=cuopt
CUOPT_TRANSPORT=nvidia_api
CUOPT_PAYLOAD_FORMAT=native
NVIDIA_API_KEY=
CUOPT_API_URL=https://optimize.api.nvidia.com/v1/nvidia/cuopt
CUOPT_SOLUTION_URL_TEMPLATE=https://optimize.api.nvidia.com/v1/status/{req_id}
CUOPT_ACTION=cuOpt_OptimizedRouting
CUOPT_CLIENT_VERSION=custom
CUOPT_TIME_LIMIT_SECONDS=5
# Warehouse rolling batches normally end at the final task instead of returning to the start depot.
CUOPT_SKIP_FIRST_TRIPS=false
CUOPT_DROP_RETURN_TRIPS=true
CUOPT_VERIFY_SSL=true
CUOPT_POLL_INTERVAL_SECONDS=1
CUOPT_MAX_POLL_ATTEMPTS=60

# Requests larger than this conservative inline limit use NVCF large assets.
CUOPT_INLINE_LIMIT_BYTES=200000
CUOPT_ASSET_API_URL=https://api.nvcf.nvidia.com/v2/nvcf/assets
CUOPT_DELETE_ASSET_AFTER_SOLVE=true

# ---------------------------------------------------------------------------
# Optional alternatives; not used when CUOPT_TRANSPORT=nvidia_api
# ---------------------------------------------------------------------------
# Self-hosted/NIM:
# CUOPT_TRANSPORT=http
# CUOPT_API_URL=http://localhost:5000/cuopt/request
# CUOPT_SOLUTION_URL_TEMPLATE=http://localhost:5000/cuopt/solution/{req_id}
# CUOPT_HEALTH_URL=http://localhost:5000/cuopt/health
# CUOPT_HTTP_AUTH_MODE=none
# CUOPT_HTTP_API_KEY=
# CUOPT_HTTP_API_KEY_HEADER=Authorization

# Older managed thin-client flow:
# CUOPT_TRANSPORT=managed
# CUOPT_CLIENT_SAK=
# CUOPT_FUNCTION_ID=
# NVIDIA_IDENTITY_FEDERATION_API_KEY=
# CUOPT_CLIENT_ID=
# CUOPT_CLIENT_SECRET=

ORTOOLS_TIME_LIMIT_SECONDS=5

FRONTEND_EXPLANATION_MODE=llm
FRONTEND_EXPLANATION_LANGUAGE=ko

ROBOT_MIN_BATTERY_PCT=30
# Deprecated legacy fallback only. Physical edges use distance_m/speed_limit_mps.
EDGE_COST_UNIT_MS=2500
TRAFFIC_SAFETY_HEADWAY_MS=500
MAPF_MAX_WAIT_MS=60000
PICKUP_SERVICE_TIME_MS=1000
PICKUP_SERVICE_TIME_PER_UNIT_MS=250
DROP_SERVICE_TIME_MS=1000
DROP_SERVICE_TIME_PER_UNIT_MS=200
NODE_CONSOLE_TRACE=true

# Map repository
MAP_REPOSITORY_BACKEND=json
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# v13.19 multi-warehouse data backends
# ---------------------------------------------------------------------------
# json: deterministic files only.
# embedded: three Docker-free SQLite files that mirror PostgreSQL/Redis/Neo4j contracts.
# live: actual PostgreSQL, Redis, and Neo4j services (Docker or local installation).
WAREHOUSE_REPOSITORY_BACKEND=json
RUNTIME_SIMULATION_ID=SIM001
INFRASTRUCTURE_STRICT_STARTUP=false

# Docker-free local contract databases (used when backend=embedded)
LOCAL_DB_DIR=.laro_local
LOCAL_POSTGRES_PATH=
LOCAL_REDIS_PATH=
LOCAL_NEO4J_PATH=

# Actual locally installed services (used when backend=live)
POSTGRES_DSN=postgresql://laro:laro@localhost:5432/laro
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_OPEN_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=laro
# Set this to neo4j together with WAREHOUSE_REPOSITORY_BACKEND=live.
# Embedded mode automatically uses its local Neo4j-contract SQLite file.
# MAP_REPOSITORY_BACKEND=neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=laro-password
NEO4J_DATABASE=neo4j

# Goods-to-person handling-unit cycle
HANDLING_UNIT_PICKUP_SERVICE_MS=1200
HANDLING_UNIT_RETURN_SERVICE_MS=900
EMPTY_TOTE_BUFFER_SERVICE_MS=500
OUTBOUND_STATION_RECEIVE_MS=500
OUTBOUND_STATION_RELEASE_MS=300
SIM_TICK_MS=100
OUTBOUND_STATION_ITEMS_PER_TICK=1
# Legacy additive fields retained for compatibility; v13.19 uses tick throughput.
OUTBOUND_STATION_BASE_SERVICE_MS=1000
OUTBOUND_STATION_PER_ORDER_SERVICE_MS=350
OUTBOUND_STATION_PER_UNIT_SERVICE_MS=0

# Outbound fulfillment
OUTBOUND_FULFILLMENT_MODE=goods_to_person
# Pure outbound waves with multiple physical handling units use one AMR per HU
# when enough eligible robots exist.  This maps to cuOpt fleet_data.min_vehicles.
G2P_DISTINCT_ROBOT_PER_HANDLING_UNIT=true
G2P_MAX_CYCLES_PER_ROBOT_PER_WAVE=1

# ---------------------------------------------------------------------------
# v13.21 deferred Rule/Agent evaluation capture
# ---------------------------------------------------------------------------
# off: no evaluation files. capture_only: freeze the request/context/primary result
# during the live scenario, then compare later through /api/v1/debug/evaluations.
PLANNING_EVALUATION_MODE=capture_only
PLANNING_EVALUATION_PERSIST=true
PLANNING_EVALUATION_OUTPUT_DIR=runtime_outputs/evaluations
PLANNING_EVALUATION_COMPARE_BACKEND=ortools
PLANNING_EVALUATION_COMPARE_DEPTH=mapf
PLANNING_EVALUATION_COMPARE_TIMEOUT_SECONDS=240
PLANNING_EVALUATION_REDACT_SECRETS=true

# Rolling-horizon terminal policy for robots released from the old plan.
IDLE_ROBOT_RELOCATION_ENABLED=true
ROBOT_OPPORTUNISTIC_CHARGE_THRESHOLD_PCT=45
ROBOT_DEFAULT_TERMINAL_POLICY=PARK
TERMINAL_RELOCATION_SERVICE_MS=500

# Local/test-only scenario runtime clone endpoint. Keep false in production.
DEBUG_SCENARIO_API_ENABLED=false

# ---------------------------------------------------------------------------
# Unmodified Spring BE OptimizationClient compatibility
# ---------------------------------------------------------------------------
BE_COMPAT_ENABLED=true
# auto: prefer Spring public graph; use laro_contract fallback on absence/mismatch.
BE_COMPAT_GRAPH_SOURCE=auto
# off | metadata | full. metadata avoids a second full graph copy in Redis.
BE_COMPAT_GRAPH_CACHE_MODE=metadata
# request_only | request_then_redis | redis_only
BE_COMPAT_RUNTIME_SOURCE=request_then_redis
BE_COMPAT_CONTRACT_SCHEMA_ENABLED=true
BE_COMPAT_DEBUG_RUNTIME_API_ENABLED=false
BE_COMPAT_DEFAULT_EDGE_STATUS=OPEN
BE_COMPAT_ROBOT_SPEED_DISTANCE_PER_SECOND=1.0
BE_COMPAT_MIN_BATTERY_PCT=30
BE_COMPAT_GRAPH_CACHE_TTL_SECONDS=86400
BE_COMPAT_NEO4J_PROJECTION=true
