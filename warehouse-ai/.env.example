OPENAI_API_KEY=
DATABASE_URL=
POSTGRES_SCHEMA_PROFILE=backend_laro
NEO4J_URI=neo4j+s://your-database-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
REDIS_URL=
CUOPT_API_KEY=
ROBOT_GATEWAY_URL=http://127.0.0.1:9000

# BE-main compose.yaml compatibility. When DATABASE_URL/REDIS_URL are blank,
# the AI service builds local PostgreSQL/Redis URLs from these values.
# NEO4J_URI is always explicit and has no localhost or Docker fallback.
# The PostgreSQL fallback selects backend_laro unless explicitly overridden.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
