# ---------------------------------------------------------------------------
# Multi-warehouse scope and physical map timing (v13.19)
# ---------------------------------------------------------------------------
# Front-end callers send warehouse_id; the server never accepts DB URIs from clients.
DEFAULT_WAREHOUSE_ID=WH-001
# Non-default JSON warehouses live under data/warehouses/<warehouse_id>.
WAREHOUSE_DATA_ROOT=data/warehouses
# Physical travel uses edge.distance_m / edge.speed_limit_mps. These are fallback values
# only for legacy map edges that do not yet have explicit physical metrics.
MAP_METERS_PER_COORDINATE_UNIT=2.5
ROBOT_NOMINAL_SPEED_MPS=1.0
MINIMUM_EDGE_TRAVEL_TIME_MS=500
# Allow a public planning request to carry a one-shot simulator runtime snapshot.
# Production deployments normally use the warehouse-scoped telemetry API instead.
ALLOW_API_RUNTIME_SNAPSHOT=true

# Actual PostgreSQL, Redis, and Neo4j installed directly on localhost.
WAREHOUSE_REPOSITORY_BACKEND=live
RUNTIME_SIMULATION_ID=SIM001
INFRASTRUCTURE_STRICT_STARTUP=true
POSTGRES_DSN=postgresql://laro:laro@localhost:5432/laro
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_OPEN_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=laro
MAP_REPOSITORY_BACKEND=neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=laro-password
NEO4J_DATABASE=neo4j

# Outbound fulfillment
OUTBOUND_FULFILLMENT_MODE=goods_to_person
G2P_DISTINCT_ROBOT_PER_HANDLING_UNIT=true
G2P_MAX_CYCLES_PER_ROBOT_PER_WAVE=1

# Agent retrieval
DEFAULT_PLANNING_MODE=llm_router
ALLOW_REQUEST_PLANNING_MODE_OVERRIDE=false
AGENT_RETRIEVAL_MODE=parallel_plan
AGENT_OPTIONAL_RETRIEVAL_PLANNER=auto
PARALLEL_RETRIEVAL_MAX_WORKERS=4
FORCE_AGENT_STRUCTURED_INPUT_ROUTER_LLM=false
FRONTEND_EXPLANATION_MODE=deterministic
