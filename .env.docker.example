# -----------------------------------------------------------------------------
# Host ports.  They match the unmodified BE-main local profile.
# -----------------------------------------------------------------------------
LARO_API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

# Shared DB credentials used by both BE-main and LARO.
POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=laro-redis
NEO4J_USER=neo4j
NEO4J_PASSWORD=laro-password

# Host-side connection URLs used by standalone Python scripts. Docker Compose
# overrides these with service-name URLs inside the laro-api container.
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/warehouse
REDIS_URL=redis://:laro-redis@localhost:6379/0
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j

# -----------------------------------------------------------------------------
# Existing Spring BE compatibility endpoints.  POST /optimize stays unchanged.
# -----------------------------------------------------------------------------
BE_COMPAT_ENABLED=true
BE_COMPAT_GRAPH_SOURCE=auto
BE_COMPAT_GRAPH_CACHE_MODE=metadata
BE_COMPAT_RUNTIME_SOURCE=request_then_redis
BE_COMPAT_CONTRACT_SCHEMA_ENABLED=true
BE_COMPAT_DEBUG_RUNTIME_API_ENABLED=true
BE_COMPAT_DEFAULT_EDGE_STATUS=OPEN
BE_COMPAT_ROBOT_SPEED_DISTANCE_PER_SECOND=1.0
BE_COMPAT_MIN_BATTERY_PCT=30
BE_COMPAT_GRAPH_CACHE_TTL_SECONDS=86400
BE_COMPAT_NEO4J_PROJECTION=true

# -----------------------------------------------------------------------------
# Native LARO plan API demo namespace.
# The start script seeds V18_mixed_inbound_outbound into the same DB servers:
#   PostgreSQL: native LARO orders/inventory/facilities
#   Redis:      laro:warehouse:WH-001:sim:SIM-V18-MIXED:*
#   Neo4j:      (:RouteNode)-[:TRAVERSES]->(:RouteNode), 220 nodes / 356 edges
# Spring data remains in its own public tables and Redis/Neo4j namespaces.
# -----------------------------------------------------------------------------
DEFAULT_WAREHOUSE_ID=WH-001
RUNTIME_SIMULATION_ID=SIM-V18-MIXED
REDIS_KEY_PREFIX=laro
OUTBOUND_FULFILLMENT_MODE=goods_to_person
ALLOW_API_RUNTIME_SNAPSHOT=true

# Communication/infrastructure check default: no OpenAI key is required.
# After the native plan API works, change this to llm_router and set OPENAI_API_KEY.
DEFAULT_PLANNING_MODE=force_rule
ALLOW_REQUEST_PLANNING_MODE_OVERRIDE=false

# Local deterministic solver for the first plan API check.
# Change to cuopt only after adding NVIDIA_API_KEY.
OPTIMIZATION_BACKEND=ortools

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

NVIDIA_API_KEY=
CUOPT_TRANSPORT=nvidia_api
CUOPT_PAYLOAD_FORMAT=native
CUOPT_API_URL=https://optimize.api.nvidia.com/v1/nvidia/cuopt
CUOPT_SOLUTION_URL_TEMPLATE=https://optimize.api.nvidia.com/v1/status/{req_id}

FRONTEND_EXPLANATION_MODE=deterministic
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=laro-native-plan-bridge
NODE_CONSOLE_TRACE=true

# Keep the first transport check small and side-effect free.
PLANNING_EVALUATION_MODE=off
