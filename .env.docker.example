# Standard host ports used by the existing Spring BE local profile.
LARO_API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687

POSTGRES_DB=warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=laro-redis
NEO4J_USER=neo4j
NEO4J_PASSWORD=laro-password

# Native structured-input planning.
DEFAULT_PLANNING_MODE=llm_router
OPTIMIZATION_BACKEND=ortools
ALLOW_API_RUNTIME_SNAPSHOT=false
WORKLOAD_RULE_MAX_OPERATION_COUNT=8
WORKLOAD_AGENT_MIN_OPERATION_COUNT=16
WORKLOAD_RULE_MAX_OPERATIONS_PER_ROBOT=2.0
WORKLOAD_AGENT_MIN_OPERATIONS_PER_ROBOT=3.0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=0
LLM_CUOPT_FORMULATION_MAX_RETRIES=0

NVIDIA_API_KEY=
CUOPT_TRANSPORT=nvidia_api
CUOPT_PAYLOAD_FORMAT=native
CUOPT_API_URL=https://optimize.api.nvidia.com/v1/nvidia/cuopt
CUOPT_SOLUTION_URL_TEMPLATE=https://optimize.api.nvidia.com/v1/status/{req_id}
CUOPT_NVCF_POLL_SECONDS=90
CUOPT_REQUEST_TIMEOUT_SECONDS=150
CUOPT_TRANSIENT_MAX_RETRIES=2
CUOPT_RETRY_BACKOFF_SECONDS=5

FRONTEND_EXPLANATION_MODE=deterministic
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=laro-be-centered-v13-27
NODE_CONSOLE_TRACE=true
PLANNING_EVALUATION_MODE=off
PLANNING_EVALUATION_COMPARE_BACKEND=cuopt

# Existing /optimize compatibility. Kept for the current BE code path.
BE_COMPAT_ENABLED=true
BE_COMPAT_GRAPH_SOURCE=auto
BE_COMPAT_GRAPH_CACHE_MODE=metadata
BE_COMPAT_RUNTIME_SOURCE=request_then_redis
BE_COMPAT_CONTRACT_SCHEMA_ENABLED=true
BE_COMPAT_DEBUG_RUNTIME_API_ENABLED=true
BE_COMPAT_DEFAULT_EDGE_STATUS=OPEN
BE_COMPAT_ROBOT_SPEED_DISTANCE_PER_SECOND=1.0
BE_COMPAT_MIN_BATTERY_PCT=30
BE_COMPAT_GRAPH_CACHE_TTL_SECONDS=86400
BE_COMPAT_NEO4J_PROJECTION=true
