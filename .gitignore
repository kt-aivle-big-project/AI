**/evaluation-output/
**/.laro_local/

# Java / Gradle
**/.gradle/
**/build/
**/out/
**/*.class

# IDE / OS
**/.idea/
**/.vscode/
**/.DS_Store
**/Thumbs.db

# Logs and local data
**/*.log
**/*.sqlite
**/*.sqlite3
**/neo4j-data/
**/redis-data/
**/postgres-data/
**/*.dump

# Local validation and packaged releases
/validation/
/*.zip
/*.sha256
/imagedefinitions.json

# The repository intentionally keeps only the release regression tests below.
# Other local/experimental tests stay available on the developer machine but
# are not candidates for a production commit.
/tests
